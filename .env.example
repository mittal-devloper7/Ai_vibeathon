# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hookforge
DATABASE_POOL_MAX=20

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Queue and Worker Configuration
QUEUE_NAME=hookforge-deliveries
WORKER_CONCURRENCY=10
GLOBAL_MAX_IN_FLIGHT=50
DEFAULT_ATTEMPT_TIMEOUT_MS=10000

# Security & HMAC Signing
HMAC_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gemini AI (Phase 5+)
GEMINI_API_KEY=dummy_gemini_api_key_for_testing
GEMINI_MODEL=gemini-3.5-flash-lite
RUN_LIVE_GEMINI_TESTS=false

# SSRF and Network Security Controls
ALLOW_INSECURE_HTTP_ENDPOINTS=false
ALLOWED_INTERNAL_HOSTS=merchant-simulator,localhost
